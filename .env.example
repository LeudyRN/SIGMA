# MySQL 8
DATABASE_URL="mysql://sigma_user:sigma_password@localhost:3306/sigma_ucotesis"
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="sigma_user"
DATABASE_PASSWORD="sigma_password"
DATABASE_NAME="sigma_ucotesis"

# JWT - replace with long, random values outside local development
JWT_ACCESS_SECRET="change-me-with-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-too-with-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Initial/test account (only used by pnpm create:user)
SIGMA_USER_MATRICULA="100000000"
SIGMA_USER_EMAIL="admin@uasd.edu.do"
SIGMA_USER_PASSWORD="replace-with-a-long-local-password"
SIGMA_USER_FIRST_NAME="Administrador"
SIGMA_USER_LAST_NAME="SIGMA"
SIGMA_USER_ROLE="ADMIN"
SIGMA_USER_ROLE_NAME="Administrador"

# Applications
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
API_INTERNAL_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
API_PORT="3001"
WEB_PORT="3000"
NODE_ENV="development"
