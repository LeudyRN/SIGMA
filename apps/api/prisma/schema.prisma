  id_usuario                                         BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                               String                          @unique(map: "uq_usuarios_uuid") @db.Char(36)
  matricula                                          String?                         @unique(map: "uq_usuarios_matricula") @db.VarChar(30)
  codigo_empleado                                    String?                         @unique(map: "uq_usuarios_codigo_empleado") @db.VarChar(30)
  nombres                                            String                          @db.VarChar(120)
  apellidos                                          String                          @db.VarChar(120)
  cedula                                             String?                         @unique(map: "uq_usuarios_cedula") @db.VarChar(20)
  email                                              String                          @unique(map: "uq_usuarios_email") @db.VarChar(190)
  telefono                                           String?                         @db.VarChar(30)
  password_hash                                      String                          @db.VarChar(255)
  estado                                             usuarios_estado                 @default(PENDIENTE)
  email_verificado_at                                DateTime?                       @db.DateTime(0)
  ultimo_acceso_at                                   DateTime?                       @db.DateTime(0)
  intentos_fallidos                                  Int                             @default(0) @db.UnsignedSmallInt
  bloqueado_hasta                                    DateTime?                       @db.DateTime(0)
  created_at                                         DateTime                        @default(now()) @db.Timestamp(0)
  updated_at                                         DateTime                        @default(now()) @db.Timestamp(0)
  deleted_at                                         DateTime?                       @db.DateTime(0)
  auditoria                                          auditoria[]
  conciliaciones_pago                                conciliaciones_pago[]
  configuraciones                                    configuraciones[]
  cuentas_bancarias                                  cuentas_bancarias[]
  comprobantes_transferencia                         comprobantes_transferencia[]
  docentes                                           docentes?
  documentos_inscripcion                             documentos_inscripcion[]
  estudiantes                                        estudiantes?
  historial_estados_inscripcion                      historial_estados_inscripcion[]
  notificaciones                                     notificaciones[]
  ofertas                                            ofertas[]
  proyecto_docentes                                  proyecto_docentes[]
  rol_permisos_rol_permisos_asignado_porTousuarios   rol_permisos[]                  @relation("rol_permisos_asignado_porTousuarios")
  sesiones                                           sesiones[]
  usuario_roles_usuario_roles_asignado_porTousuarios usuario_roles[]                 @relation("usuario_roles_asignado_porTousuarios")
  usuario_roles_usuario_roles_id_usuarioTousuarios   usuario_roles[]                 @relation("usuario_roles_id_usuarioTousuarios")
  validaciones_requisitos                            validaciones_requisitos[]

  @@index([estado], map: "idx_usuarios_estado")
  @@index([apellidos, nombres], map: "idx_usuarios_nombre")
}

model validaciones_requisitos {
  id_validacion            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  id_inscripcion           BigInt        @db.UnsignedBigInt
  id_requisito             BigInt        @db.UnsignedBigInt
  cumple                   Boolean
  valor_obtenido           String?       @db.VarChar(500)
  observacion              String?       @db.VarChar(1000)
  validado_automaticamente Boolean       @default(false)
  validado_por             BigInt?       @db.UnsignedBigInt
  fecha_validacion         DateTime      @default(now()) @db.DateTime(0)
  created_at               DateTime      @default(now()) @db.Timestamp(0)
  inscripciones            inscripciones @relation(fields: [id_inscripcion], references: [id_inscripcion], onDelete: Cascade, map: "fk_validaciones_inscripcion")
  requisitos               requisitos    @relation(fields: [id_requisito], references: [id_requisito], map: "fk_validaciones_requisito")
  usuarios                 usuarios?     @relation(fields: [validado_por], references: [id_usuario], map: "fk_validaciones_usuario")

  @@unique([id_inscripcion, id_requisito], map: "uq_validacion_inscripcion_requisito")
  @@index([validado_por], map: "fk_validaciones_usuario")
  @@index([id_requisito], map: "idx_validaciones_requisito")
  @@index([cumple], map: "idx_validaciones_resultado")
}

