generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model areas_investigacion {
  id_area         BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  codigo          String                     @unique(map: "uq_areas_codigo") @db.VarChar(40)
  nombre          String                     @unique(map: "uq_areas_nombre") @db.VarChar(150)
  descripcion     String?                    @db.VarChar(500)
  estado          areas_investigacion_estado @default(ACTIVO)
  created_at      DateTime                   @default(now()) @db.Timestamp(0)
  updated_at      DateTime                   @default(now()) @db.Timestamp(0)
  oferta_areas    oferta_areas[]
  proyectos_grado proyectos_grado[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asignaturas {
  id_asignatura BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  codigo        String @unique(map: "uq_asignaturas_codigo") @db.VarChar(30)
  nombre        String @db.VarChar(180)

  horas_teoricas  Int @default(0) @db.UnsignedSmallInt
  horas_practicas Int @default(0) @db.UnsignedSmallInt

  creditos   Decimal            @default(0.00) @db.Decimal(5, 2)
  estado     asignaturas_estado @default(ACTIVO)
  created_at DateTime           @default(now()) @db.Timestamp(0)
  updated_at DateTime           @default(now()) @db.Timestamp(0)

  historial_academico      historial_academico[]
  plan_estudio_asignaturas plan_estudio_asignaturas[]

  relaciones_origen  asignatura_relaciones[] @relation("asignatura_relacion_origen")
  relaciones_destino asignatura_relaciones[] @relation("asignatura_relacion_destino")

  @@index([nombre], map: "idx_asignaturas_nombre")
}

model auditoria {
  id_auditoria     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario       BigInt?   @db.UnsignedBigInt
  accion           String    @db.VarChar(100)
  entidad          String    @db.VarChar(100)
  entidad_id       String?   @db.VarChar(100)
  datos_anteriores Json?
  datos_nuevos     Json?
  ip               String?   @db.VarChar(45)
  user_agent       String?   @db.VarChar(500)
  request_id       String?   @db.VarChar(100)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  usuarios         usuarios? @relation(fields: [id_usuario], references: [id_usuario], map: "fk_auditoria_usuario")

  @@index([accion, created_at], map: "idx_auditoria_accion_fecha")
  @@index([entidad, entidad_id], map: "idx_auditoria_entidad")
  @@index([id_usuario, created_at], map: "idx_auditoria_usuario_fecha")
}

model carreras {
  id_carrera       BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  id_escuela       BigInt             @db.UnsignedBigInt
  codigo           String             @unique(map: "uq_carreras_codigo") @db.VarChar(30)
  nombre           String             @db.VarChar(150)
  nivel_academico  String             @default("GRADO") @db.VarChar(60)
  estado           carreras_estado    @default(ACTIVO)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  updated_at       DateTime           @default(now()) @db.Timestamp(0)
  escuelas         escuelas           @relation(fields: [id_escuela], references: [id_escuela], map: "fk_carreras_escuela")
  planes_estudio   planes_estudio[]
  recinto_carreras recinto_carreras[]

  @@index([id_escuela], map: "idx_carreras_escuela")
}

model conciliacion_detalles {
  id_conciliacion     BigInt              @db.UnsignedBigInt
  id_pago             BigInt              @db.UnsignedBigInt
  monto_reportado     Decimal?            @db.Decimal(12, 2)
  coincide            Boolean             @default(false)
  observacion         String?             @db.VarChar(500)
  created_at          DateTime            @default(now()) @db.Timestamp(0)
  conciliaciones_pago conciliaciones_pago @relation(fields: [id_conciliacion], references: [id_conciliacion], onDelete: Cascade, map: "fk_cd_conciliacion")
  pagos               pagos               @relation(fields: [id_pago], references: [id_pago], map: "fk_cd_pago")

  @@id([id_conciliacion, id_pago])
  @@index([id_pago], map: "idx_cd_pago")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conciliaciones_pago {
  id_conciliacion       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  codigo                String                     @unique(map: "uq_conciliaciones_codigo") @db.VarChar(60)
  proveedor             String                     @db.VarChar(80)
  fecha_desde           DateTime                   @db.DateTime(0)
  fecha_hasta           DateTime                   @db.DateTime(0)
  total_registros       Int                        @default(0) @db.UnsignedInt
  total_monto           Decimal                    @default(0.00) @db.Decimal(14, 2)
  estado                conciliaciones_pago_estado @default(ABIERTA)
  procesada_por         BigInt?                    @db.UnsignedBigInt
  procesada_at          DateTime?                  @db.DateTime(0)
  created_at            DateTime                   @default(now()) @db.Timestamp(0)
  conciliacion_detalles conciliacion_detalles[]
  usuarios              usuarios?                  @relation(fields: [procesada_por], references: [id_usuario], map: "fk_conciliaciones_usuario")

  @@index([procesada_por], map: "fk_conciliaciones_usuario")
}

model configuraciones {
  id_configuracion BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  clave            String               @unique(map: "uq_configuraciones_clave") @db.VarChar(120)
  valor            String?              @db.Text
  tipo             configuraciones_tipo @default(STRING)
  descripcion      String?              @db.VarChar(500)
  es_publica       Boolean              @default(false)
  updated_by       BigInt?              @db.UnsignedBigInt
  created_at       DateTime             @default(now()) @db.Timestamp(0)
  updated_at       DateTime             @default(now()) @db.Timestamp(0)
  usuarios         usuarios?            @relation(fields: [updated_by], references: [id_usuario], map: "fk_configuraciones_usuario")

  @@index([updated_by], map: "fk_configuraciones_usuario")
}

model cuentas_bancarias {
  id_cuenta_bancaria BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  banco              String                        @db.VarChar(120)
  numero_cuenta      String                        @unique(map: "uq_cuentas_bancarias_numero") @db.VarChar(80)
  tipo_cuenta        cuentas_bancarias_tipo_cuenta
  tipo_documento     String                        @db.VarChar(30)
  documento_titular  String                        @db.VarChar(30)
  nombre_titular     String                        @db.VarChar(200)
  moneda             String                        @default("DOP") @db.Char(3)
  instrucciones      String?                       @db.VarChar(1000)
  estado             cuentas_bancarias_estado      @default(ACTIVO)
  created_by         BigInt?                       @db.UnsignedBigInt
  created_at         DateTime                      @default(now()) @db.Timestamp(0)
  updated_at         DateTime                      @default(now()) @db.Timestamp(0)
  usuarios           usuarios?                     @relation(fields: [created_by], references: [id_usuario], map: "fk_cuentas_bancarias_usuario")
  pagos              pagos[]

  @@index([estado, banco], map: "idx_cuentas_bancarias_estado")
  @@index([created_by], map: "idx_cuentas_bancarias_usuario")
}

model comprobantes_transferencia {
  id_comprobante BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  id_pago        BigInt                            @unique(map: "uq_comprobantes_transferencia_pago") @db.UnsignedBigInt
  nombre_archivo String                            @db.VarChar(255)
  mime_type      String                            @db.VarChar(120)
  tamano_bytes   Int                               @db.UnsignedInt
  hash_sha256    String                            @db.Char(64)
  contenido      Bytes                             @db.LongBlob
  estado         comprobantes_transferencia_estado @default(PENDIENTE)
  observacion    String?                           @db.VarChar(500)
  revisado_por   BigInt?                           @db.UnsignedBigInt
  revisado_at    DateTime?                         @db.DateTime(0)
  created_at     DateTime                          @default(now()) @db.Timestamp(0)
  updated_at     DateTime                          @default(now()) @db.Timestamp(0)
  pagos          pagos                             @relation(fields: [id_pago], references: [id_pago], onDelete: Cascade, map: "fk_comprobantes_transferencia_pago")
  usuarios       usuarios?                         @relation(fields: [revisado_por], references: [id_usuario], map: "fk_comprobantes_transferencia_revisor")

  @@index([estado, created_at], map: "idx_comprobantes_transferencia_estado")
  @@index([revisado_por], map: "idx_comprobantes_transferencia_revisor")
}

model docentes {
  id_docente        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario        BigInt              @unique(map: "uq_docentes_usuario") @db.UnsignedBigInt
  codigo_docente    String              @unique(map: "uq_docentes_codigo") @db.VarChar(50)
