{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.nest-dev",
    "tsBuildInfoFile": "./.nest-dev/tsconfig.dev.tsbuildinfo",
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    ".nest-dev",
    "**/*spec.ts",
    "prisma.config.ts",
    "scripts"
  ],
  "include": ["src/**/*.ts"]
}
